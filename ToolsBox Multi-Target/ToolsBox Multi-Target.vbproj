<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>
	     net5.0-windows;
	     net6.0-windows;
	     net7.0-windows;
         net8.0-windows;
         net9.0-windows;
		 net10.0-windows10.0.19041.0
    </TargetFrameworks>

    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ToolsBox</RootNamespace>
    <AssemblyName>ToolsBox</AssemblyName>
    <ApplicationIcon>ToolsBox.ico</ApplicationIcon>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>ToolsBox.</StartupObject>
    <Version>0.2.2.6</Version>
    <Authors>Copyright ©  2025 - Rômulo Meirelles</Authors>
    <Company>Digital Compiler.</Company>
    <Description>ToolsBox. Ferramentas Necessárias</Description>
    <Product>ToolsBox. Ferramentas Necessárias</Product>
    <Title>ToolsBox</Title>
    <Copyright>Copyright ©  2025 - Rômulo Meirelles</Copyright>
    <PackageProjectUrl>https://github.com/Romulo-Meirelles/ToolsBox</PackageProjectUrl>
    <PackageIcon>ToolsBox.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Pictures\ToolsBox.ico" />
    <Content Include="Pictures\Tools_System.ico" />
    <Content Include="ToolsBox.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Pictures\Black.ico" />
    <EmbeddedResource Include="Pictures\Blue.ico" />
    <EmbeddedResource Include="Pictures\DarkBlue.ico" />
    <EmbeddedResource Include="Pictures\DarkGreen.ico" />
    <EmbeddedResource Include="Pictures\DarkPink.ico" />
    <EmbeddedResource Include="Pictures\DarkRed.ico" />
    <EmbeddedResource Include="Pictures\Green.ico" />
    <EmbeddedResource Include="Pictures\LimeGreen.ico" />
    <EmbeddedResource Include="Pictures\Magenta.ico" />
    <EmbeddedResource Include="Pictures\Orange.ico" />
