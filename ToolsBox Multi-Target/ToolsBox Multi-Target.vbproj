    <EmbeddedResource Include="Pictures\Purple.ico" />
    <EmbeddedResource Include="Pictures\Red.ico" />
    <EmbeddedResource Include="Pictures\White.ico" />
    <EmbeddedResource Include="Pictures\WhiteBlue.ico" />
    <EmbeddedResource Include="Pictures\WhitePurple.ico" />
    <EmbeddedResource Include="Pictures\Yellow.ico" />
  </ItemGroup>

  
  <ItemGroup>
